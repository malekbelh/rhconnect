# Variables d'environnement du backend RHConnect
# Copier en .env et renseigner les valeurs (ne jamais commiter .env)

# MongoDB
MONGO_URI=mongodb://localhost:27017/rhconnect

# JWT (obligatoire) - cle Base64 d'au moins 256 bits, ex : openssl rand -base64 48
JWT_SECRET=
ACCESS_TTL=900
REFRESH_TTL=604800

# Reinitialisation du mot de passe
RESET_TOKEN_TTL=30
APP_BASE_URL=http://localhost:5173

# SMTP (Gmail : utiliser un mot de passe d'application)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# IA / Ollama
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=120

# Seed
SEED_FORCE=false
